{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/images/world-nkorea.webp",
      "destination": "https://assets.korearisk.com/uploads/2026/11/rodong-nov12-2026-kju-naval-base-construction-east-coast-munchon-5.jpeg"
    },
    {
      "source": "/images/africa-drc.webp",
      "destination": "https://images.euronews.com/articles/stories/09/98/90/18/1024x576_cmsv2_094605e3-cdf0-5d91-82b3-69619c4786cb-9989018.jpg"
    },
    {
      "source": "/images/africa-sa.webp",
      "destination": "https://cloudfront-us-east-2.images.arcpublishing.com/reuters/J4K2MLJR2NO4DNH4GKNMW77SRI.jpg"
    },
    {
      "source": "/images/nigeria-borrowing.webp",
      "destination": "https://upload.wikimedia.org/wikipedia/commons/7/77/Bola_Tinubu_portrait.jpg"
    },
    {
      "source": "/images/nigeria-inec.webp",
      "destination": "https://upload.wikimedia.org/wikipedia/commons/f/f3/INEC_Headquarter%2C_Abuja.jpg"
    },
    {
      "source": "/images/business-dangote.webp",
      "destination": "https://upload.wikimedia.org/wikipedia/commons/b/b4/Dangote-refinery-Lekki-drone-small-Lagos-Nigeria-IMG_7237b.jpg"
    },
    {
      "source": "/images/business-markets.webp",
      "destination": "https://media-cldnry.s-nbcnews.com/image/upload/newscms/2020_12/3279436/200322-new-york-stock-exchange-coronavirus-cs-1144a.jpg"
    },
    {
      "source": "/images/tech-meta.webp",
      "destination": "https://cloudfront-us-east-2.images.arcpublishing.com/reuters/LX55NIUH2NIQDOSFK7OZGOV4OI.jpg"
    },
    {
      "source": "/images/sports-flamingos.webp",
      "destination": "https://media.afrik-foot.com/en-ng/2026/11/ca2df12b-b33a-46c1-b40f-a15153ace272.png"
    },
    {
      "source": "/images/ent-latingrammy.webp",
      "destination": "https://www.billboard.com/wp-content/uploads/2026/11/Latin-Grammy-2026-Special-Awards-cr-Latin-Recording-Academy-billboard-1800.jpg?w=1200&h=800&crop=1"
    },
    {
      "source": "/images/health-ebola.webp",
      "destination": "https://www.aljazeera.com/wp-content/uploads/2026/10/afp_6ad39d0c86f8-1792253196.jpg?resize=1200%2C800&quality=80"
    },
    {
      "source": "/images/health-lenacapavir.webp",
      "destination": "https://cdn.who.int/media/images/default-source/headquarters/teams/uhc---communicable-noncommunicable-diseases-(ucn)/global-hiv-hepatitis-and-stis-programmes-(hhs)/lenacapavir-vial.jpg?sfvrsn=f2bb3d64_8"
    },
    {
      "source": "/images/science-cop31.webp",
      "destination": "https://cloudfront-us-east-2.images.arcpublishing.com/reuters/GUAGY4J22ZIKLCMQJ44IDSYXDY.jpg"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
